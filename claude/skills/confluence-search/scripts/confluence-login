#!/usr/bin/env bash
# confluence-login — install your own Confluence personal access token.
#
# A bash script, not Python, so it runs from a user's plain login shell. That
# shell usually has no `uv` on PATH: on S3DF only claude-lcls and
# opencode-sandbox put the shared one there, and only for their own processes.
# This script sources the skill's env.sh first, which puts the facility's
# shared uv on PATH, and only then starts Python. The earlier
# `#!/usr/bin/env -S uv run --script` version failed at exactly the step a new
# user is told to run: "/usr/bin/env: 'uv': No such file or directory".
#
# Its own command rather than a flag on install.sh, because the two have
# different audiences: deploying the skill is a maintainer's job done once,
# installing a token is every user's own and cannot be done for them. It lives
# in the skill's scripts/ directory so it reaches users who were handed the
# deployed skill and never saw the source repo.
#
# The implementation stays in cqlsearch.py, which resolves the token path. Two
# copies of that resolution would drift, and then login would write where
# search does not read.
#
#   confluence-login              prompt (hidden), write mode 600, verify
#   confluence-login --from FILE  read the token from a file instead
#   confluence-login --force      replace an existing token
#   confluence-login --no-verify  skip the one live check

# Resolve symlinks, so a link to this file from somewhere like ~/bin still
# finds the skill directory it belongs to.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
skill_dir="$(dirname "$here")"
script="$here/cqlsearch.py"

if [ -f "$skill_dir/env.sh" ]; then
    # shellcheck source=/dev/null
    source "$skill_dir/env.sh"
fi

if command -v uv >/dev/null 2>&1; then
    exec uv run --script "$script" login "$@"
fi
# cqlsearch.py is standard-library only, so a new enough python3 also works.
if python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
    exec python3 "$script" login "$@"
fi
echo "confluence-login: needs uv, or python3 3.9 or newer, and found neither on PATH." >&2
echo "                  Install uv (https://docs.astral.sh/uv/) and run this again." >&2
exit 127
